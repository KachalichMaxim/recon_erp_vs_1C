//загрузить изменения по сообщениям архива ЭДО
Функция getEDOArhChangesOneOrg(dtb, dte, orgid)
	retval = "";
	sql = "
	|ВЫБРАТЬ  
    |  	ЭДОДок.ИдентификаторДокументооборота,
    |  	ЖЭДО.ЭлектронныйДокумент,
    |  	ЖЭДО.Действие, 
    |  	ЖЭДО.Сообщение,
    |  	ЖЭДО.СтатусСообщения,
    |  	ЖЭДО.ДатаИзменения,
    |  	ЖЭДО.СостояниеДокумента
    |ИЗ
	|	Документ.ЭлектронныйДокументВходящийЭДО КАК ЭДОДок
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналДействийПоЭДО КАК ЖЭДО
	|	ПО ЖЭДО.ЭлектронныйДокумент=ЭДОДок.Ссылка
    |ГДЕ
	|    ЖЭДО.ДатаИзменения МЕЖДУ &НачДата И &КонДата
    |    И ЭДОДок.Организация = &Организация 
	|УПОРЯДОЧИТЬ ПО ЭДОДок.ИдентификаторДокументооборота,ЖЭДО.ДатаИзменения
	|";
	org = Справочники.Организации.НайтиПоКоду(orgid);
	Если не org.Пустая() Тогда
		Запрос = Новый Запрос(sql); 
    	Запрос.УстановитьПараметр("НачДата", dtb);//Дата всегда на 00:00:00
		Запрос.УстановитьПараметр("КонДата", КонецДня(dte));
		Запрос.УстановитьПараметр("Организация", org.Ссылка);
		Результат = Запрос.Выполнить().Выбрать();
		Счётчик = 0;
		Пока Результат.Следующий() Цикл 
			Если стрДлина(retval)>0 Тогда
				retval=retval+",";
			КонецЕсли;
			retval=retval+"{"+
			"""edid"":"""+Результат.ИдентификаторДокументооборота+
			""",""dttmchng"":"""+Формат(Результат.ДатаИзменения, "ДФ='yyyy-MM-dd HH:mm:ss'")+
			""",""action"":"""+Результат.Действие+
			""",""statusmes"":"""+Результат.СтатусСообщения+
			""",""statusdoc"":"""+Результат.СостояниеДокумента+""""
			"}";
			Счётчик = Счётчик + 1;
		КонецЦикла;
	КонецЕсли;
	Возврат(retval);
КонецФункции

//проверяет наличие связки счета и платежного поручения
Функция checkInvWithPP(invnum, invdt, orgnum)
	Перем retval,sql,org;
	retval="[{""retval"":""false"",""msg"":""Ошибка получения данных ("+invnum+","+invdt+","+orgnum+")""}]";
	sql = "
		|ВЫБРАТЬ 
		|	ДокРасчетныйСчет.Ссылка,
		|	Счет.Ссылка КАК Ссылка
    	|ИЗ
		|	Документ.ПоступлениеНаРасчетныйСчет КАК ДокРасчетныйСчет,
		|	Документ.СчетНаОплатуПокупателю КАК Счет
	    |ГДЕ
		|	ДокРасчетныйСчет.РасшифровкаПлатежа.СчетНаОплату=Счет.Ссылка
		|   И Счет.Дата МЕЖДУ &НачДата И &КонДата
		|   И Счет.Номер = &Номер
    	|   И Счет.Организация = &Организация
    	|";
	org = Справочники.Организации.НайтиПоКоду(orgnum);
	Если не org.Пустая() Тогда
