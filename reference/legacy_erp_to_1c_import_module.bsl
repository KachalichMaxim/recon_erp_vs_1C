//добавить обновить номенклатуру
Функция addupdNomenk(kod1c, name, group1c, edizm, jstr)
	Перем retval,sql,org,usl,ЧтениеДЖ,МассивДжи,ТабЧСч,retmsg,fd;
	fd=0;
	retval = "{""retval"":""false"",""msg"":""Ошибка не определена""}";
	retmsg = "";
	Если стрДлина(kod1c)>0 Тогда
		sql = "
		|ВЫБРАТЬ 
		|    Номенклатура.Ссылка
    	|ИЗ
		|    Справочник.Номенклатура КАК Номенклатура
    	|ГДЕ
		|    Номенклатура.Код = &Код
    	|";
		Запрос = Новый Запрос(sql); 
		Запрос.УстановитьПараметр("Код", kod1c);
		Результат = Запрос.Выполнить().Выбрать(); 
		Если Результат.Следующий() Тогда
			Номенк = Результат.Ссылка.ПолучитьОбъект();
			fd=2;
			retmsg = "Нашли запись номенклатуры <br>";
		КонецЕсли;
	Иначе
		Номенк = Справочники.Номенклатура.СоздатьЭлемент();
		fd=1;
		retmsg = "Создали запись номенклатуры <br>";
	КонецЕсли;
	Если fd=1 Тогда
		Номенк.Родитель				= Справочники.Номенклатура.НайтиПоКоду(group1c);
		Номенк.ВидНоменклатуры		= Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Услуги",Истина);
		Номенк.Наименование			= name;
		Номенк.НаименованиеПолное 	= name;
		Номенк.ЕдиницаИзмерения  	= Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(edizm,Истина);
	ИначеЕсли fd=2 Тогда
		Номенк.Наименование			= name;
		Номенк.НаименованиеПолное 	= name;
		Номенк.ЕдиницаИзмерения  	= Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(edizm,Истина);
	КонецЕсли;
	Если fd=1 или fd=2 Тогда
		Попытка
			Номенк.Записать();
			retmsg=retmsg+"Номенклатура сохранена<br>";
			retval="{""retval"":""true"",""msg"":"""+Номенк.Код+""",""descr"":"""+retmsg+"""}";
		Исключение
			retmsg=retmsg+"Ошибка сохранения: "+СтрЗаменить(ОписаниеОшибки(),"""","'")+"<br>";
			retval = "{""retval"":""false"",""msg"":"""+retmsg+"""}";
		КонецПопытки;
	КонецЕсли;
	Возврат(retval);
КонецФункции

//загрузить изменения по сообщениям архива ЭДО, все организации
Функция getEDOArhChanges(dtb, dte, orgid)
	Перем retval,sql,org,Запрос,curret;
	retval="";
	//Попытка
		Если orgid="0" Тогда
			sql = "
			| Выбрать Ссылка 
			| ИЗ Справочник.Организации";
			Запрос = Новый Запрос(sql); 
			Результат = Запрос.Выполнить().Выбрать(); 
			Пока Результат.Следующий() Цикл 
				Если Результат.Ссылка.ПометкаУдаления = Ложь Тогда
					curret=getEDOArhChangesOneOrg(dtb,dte,Результат.Ссылка.Код);
