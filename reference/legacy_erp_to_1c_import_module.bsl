			КонецЕсли;
			//sdid2669
			Если ЗначениеЗаполнено(nalognumber) Тогда
				Объект.НалоговыйНомер = nalognumber;
			КонецЕсли;
			//~sdid2669
			Если ЗначениеЗаполнено(vid) Тогда
