//удалить документ - корректировка долга
Функция deleteDutyCorrect(dognum, dogdt)
	Перем 	retval,descr,sql;
	retval="";descr="";
	sql = "
	|ВЫБРАТЬ 
	|    КорректировкаДолга.Ссылка 
    |ИЗ
    |    Документ.КорректировкаДолга КАК КорректировкаДолга
    |ГДЕ
	|    КорректировкаДолга.Дата МЕЖДУ &НачДата И &КонДата
    |    И КорректировкаДолга.Номер = &Номер ";
	Запрос = Новый Запрос(sql); 
	Запрос.УстановитьПараметр("НачДата", dogdt);//Дата всегда на 00:00:00
	Запрос.УстановитьПараметр("КонДата", КонецДня(dogdt));
	Запрос.УстановитьПараметр("Номер", dognum);
	Результат = Запрос.Выполнить().Выбрать(); 
	Если Результат.Следующий() Тогда
		Объект	= Результат.Ссылка.ПолучитьОбъект();
		descr = descr+"Документ найден. ";
		Попытка
			Объект.УстановитьПометкуУдаления(Истина);
			descr = descr+"Установили пометку удаления. ";
			retval="{""retval"":""true"",""msg"":""описание: "+descr+"""}";
		Исключение
			retval="{""retval"":""false"",""msg"":""Ошибка удаления документа: "+ОписаниеОшибки()+"_"+descr+"""}";
		КонецПопытки;
	Иначе
		//descr = descr+"Документ НЕ найден в 1С. ";
		retval="{""retval"":""false"",""msg"":""Ошибка удаления документа: Документ НЕ найден в 1С.""}";
	КонецЕсли;
	Возврат(retval);
КонецФункции

