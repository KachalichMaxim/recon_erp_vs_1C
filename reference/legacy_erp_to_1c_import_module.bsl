			retval="[{""retval"":""true"",""msg"":"""+КонтрагентСсылка.Код+"""}]";
		Иначе 
			cstep=0;
		КонецЕсли;
	КонецЕсли;
	//КонецЕсли;
	Если cstep=0 Тогда//создаем нового контрагента
		Если (стрДлина(cname)>1) И (стрДлина(addname)>1) Тогда
			cstep =4;
			Объект = Справочники.Контрагенты.СоздатьЭлемент();
			Объект.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
