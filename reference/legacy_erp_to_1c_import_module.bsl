					Объект.ИНН = inn;
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(kpp) Тогда
				Если стрДлина(kpp)>2 Тогда
					Объект.КПП = kpp;
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(ogrn) Тогда
				Если стрДлина(ogrn)>2 Тогда
					Объект.РегистрационныйНомер = ogrn;
				КонецЕсли;
			КонецЕсли;
			Если стрДлина(СокрЛП(cgroup))>0 Тогда//если есть группа
				Объект.Родитель = Справочники.Контрагенты.НайтиПоНаименованию(cgroup);
			КонецЕсли;
			Если ЗначениеЗаполнено(clcntrreg) Тогда
				НайденнаяСтранаПроисхождения = Справочники.СтраныМира.НайтиПоНаименованию(clcntrreg,1);
