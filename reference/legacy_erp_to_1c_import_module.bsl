Функция getEDOArhOneOrg(dtb,dte,orgid)
	Перем retval,sql,org,ТекСтрокапроводки,contrid;
	Перем масзап,докнум,докдата,ИтогКол,ИтогСум,ИтогНДС,СтрокаXML;
	Перем наимбанк, бик, ксчет, рсчет, догдата, догнум;
	retval="";
	sql = "
	|ВЫБРАТЬ 
	|    ЭДОДок.Ссылка,
	|    ЭДОДок.Номер,
	|    ЭДОДок.Дата,
	|    ЭДОДок.ВидДокумента,
	|    ЭДОДок.НомерДокумента,
	|    ЭДОДок.ДатаДокумента,
	|    ЭДОДок.Контрагент,
	|    ЭДОДок.ИдентификаторКонтрагента,
	|    ЭДОДок.Организация,
	|    ЭДОДок.ИдентификаторОрганизации,
	|    ЭДОДок.ГигПроверенЛогистом,
	|    ЭДОДок.СуммаДокумента,
	|    ЭДОДок.ДатаПолучения,
	|    ЭДОДок.ИдентификаторДокументооборота,
	|    СЭДО.ОсновнойФайл ОсновнойФайл,
	|    СЭДО.Направление
    |ИЗ
	|	Документ.ЭлектронныйДокументВходящийЭДО КАК ЭДОДок
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СообщениеЭДО СЭДО
	|	ПО СЭДО.ЭлектронныйДокумент=ЭДОДок.Ссылка 
	|	И ЭДОДок.ВидДокумента=СЭДО.ВидСообщения
    |ГДЕ
	|    ЭДОДок.Дата МЕЖДУ &НачДата И &КонДата
    |    И ЭДОДок.Организация = &Организация 
	|УПОРЯДОЧИТЬ ПО ЭДОДок.ДатаПолучения
	|";
	org = Справочники.Организации.НайтиПоКоду(orgid);
	Если не org.Пустая() Тогда
		Запрос = Новый Запрос(sql); 
    	Запрос.УстановитьПараметр("НачДата", dtb);//Дата всегда на 00:00:00
		Запрос.УстановитьПараметр("КонДата", КонецДня(dte));
		Запрос.УстановитьПараметр("Организация", org.Ссылка);
		Результат = Запрос.Выполнить().Выбрать();
		Счётчик = 0;
		Пока Результат.Следующий() Цикл 
			sql = 
      			"ВЫБРАТЬ 
				|	ЭД.ПолноеИмяФайла,
				|	ЭД.Расширение
			    |ИЗ
				|	Справочник.СообщениеЭДОПрисоединенныеФайлы КАК ЭД 
      			|ГДЕ
      			|   ЭД.Ссылка = &Ссылка
				|";
			Запрос1 = Новый Запрос(sql); 
			Запрос1.УстановитьПараметр("Ссылка",Результат.ОсновнойФайл);
			Результат1 = Запрос1.Выполнить().Выбрать(); 
			dop = "[";
			Пока Результат1.Следующий() Цикл 
				Если стрДлина(dop)>2 Тогда
					dop=dop+",";
				КонецЕсли;
				dop = dop+"{"+
				"""filename"":"""+СтрЗаменить(СтрЗаменить(Результат1.ПолноеИмяФайла,"\","\\"),"""","\""")+
				""",""fileext"":"""+Результат1.Расширение+
				"""}";
			КонецЦикла;
			dop = dop+"]";
			Если стрДлина(retval)>0 Тогда
				retval=retval+",";
			КонецЕсли;
			СостояниеПодробное = ЭлектронныеДокументыЭДО.СостояниеДокументаПодробное(Результат.Ссылка);
			retval=retval+"{"+
			"""edtype"":"""+Результат.ВидДокумента+
			""",""kodc"":"""+Результат.Номер+
			""",""dtc"":"""+Результат.Дата+
			""",""numvh"":"""+Результат.НомерДокумента+
			""",""dtvh"":"""+Результат.ДатаДокумента+
			""",""org"":"""+СтрЗаменить(Результат.Организация,"""","\""")+
			""",""orgid"":"""+Результат.Организация.Код+
			""",""contr"":"""+СтрЗаменить(Результат.Контрагент,"""","\""")+
			""",""contrid"":"""+Результат.Контрагент.Код+
			""",""logist"":"""+Результат.ГигПроверенЛогистом+
			""",""edid"":"""+Результат.ИдентификаторДокументооборота+
			""",""docsum"":"""+Результат.СуммаДокумента+
			""",""curst"":"""+СостояниеПодробное.Значение+
			""",""direct"":"""+Результат.Направление+
			""",""dop"":"+dop+
			"}";
			Счётчик = Счётчик + 1;
		КонецЦикла;
	КонецЕсли;
	Возврат(retval);
КонецФункции

