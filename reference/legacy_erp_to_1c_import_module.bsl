					descr = "("+descr+")";
					retval="{""retval"":""true"",""c1guid"":"""+УИН+""",""msg"":"""+Объект.Номер+
							""",""dt"":"""+Объект.Дата+""",""status"":"""+astat+""",""descr"":"""+descr+"""}";
				Исключение
					retval="{""retval"":""false"",""c1guid"":"""+УИН+""",""status"":"""+astat+""",""msg"":""Ошибка создания акта: |"+act+"|"+num+"|"+ numc+"|"+orgid+"|"+dogid+"|"+descr+"_|"+ПолучитьСтрокуВозврата(ОписаниеОшибки())+"""}";//sdid 3478 3594
				КонецПопытки;
