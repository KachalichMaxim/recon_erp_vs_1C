Функция getEDOfl(edid)
	Перем retval,sql;
	retval = edid;
	retval = "";
	sql = "
	|ВЫБРАТЬ 
	|	ЭДОДок.Ссылка,
	|	СЭДО.ОсновнойФайл
    |ИЗ
	|	Документ.ЭлектронныйДокументВходящийЭДО КАК ЭДОДок
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СообщениеЭДО СЭДО
	|	ПО СЭДО.ЭлектронныйДокумент=ЭДОДок.Ссылка 
	|	И ЭДОДок.ВидДокумента=СЭДО.ВидСообщения
    |ГДЕ
	|    ЭДОДок.ИдентификаторДокументооборота=&УникальныйИД
	|";	
	Запрос = Новый Запрос(sql);
	Запрос.УстановитьПараметр("УникальныйИД", edid);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
        ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(Результат.ОсновнойФайл);
		retval = Base64Строка(ДвоичныеДанные);
	КонецЕсли;
	Возврат(retval);
КонецФункции

Функция setEDOLogist(edid, islog)
	Перем retval,sql,sqldop,сstat,ЭлементСчет;
	retval="";
	Если стрДлина(edid)>0  Тогда
		sql = "
		|ВЫБРАТЬ 
		|    ЭДОДок.ГигПроверенЛогистом,
		|    ЭДОДок.Ссылка
	    |ИЗ
		|	Документ.ЭлектронныйДокументВходящийЭДО КАК ЭДОДок
    	|ГДЕ
		|    ЭДОДок.ИдентификаторДокументооборота=&УникальныйИД
		|";
		Запрос = Новый Запрос(sql);
		Запрос.УстановитьПараметр("УникальныйИД", edid);
		Результат = Запрос.Выполнить().Выбрать(); 
		Если Результат.Следующий() Тогда
			Попытка
				Если (Результат.ГигПроверенЛогистом = Истина И islog=0) или
				 (Результат.ГигПроверенЛогистом = Ложь И islog=1)Тогда
					ДокОбъект = Результат.Ссылка.ПолучитьОбъект(); 
					Если islog=0 Тогда
						ДокОбъект.ГигПроверенЛогистом = Ложь;
					Иначе
						ДокОбъект.ГигПроверенЛогистом = Истина;
					КонецЕсли;
					ДокОбъект.Записать(); 
				КонецЕсли;
			retval="[{""retval"":""true"",""msg"":""ok""}]";
			Исключение
				retval="[{""retval"":""false"",""msg"":""Ошибка установки значения""}]";
			КонецПопытки;
		ИНАЧЕ
			retval="[{""retval"":""false"",""msg"":""ЭДО не найден""}]";
		КонецЕсли;
	ИНАЧЕ
		retval="[{""retval"":""false"",""msg"":""ЭДО не задан""}]";
	КонецЕсли;
	Возврат(retval);	
КонецФункции

