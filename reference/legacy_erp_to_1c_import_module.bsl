Функция getOrgs()
	Перем retval,sql;
	retval="";
	sql = "
	|ВЫБРАТЬ 
	|	Код, Наименование, ИНН
	|ИЗ 
	|	Справочник.Организации  
	|УПОРЯДОЧИТЬ ПО Наименование";
	Запрос = Новый Запрос(sql); 
	Результат = Запрос.Выполнить().Выбрать(); 
	Пока Результат.Следующий() Цикл 
		Если стрДлина(retval)>0 Тогда
			retval=retval+",";
		КонецЕсли;
		retval=retval+"{""kod1c"":"""+Результат.Код+""",""name"":"""+СтрЗаменить(Результат.Наименование,"""","\""")+""",""inn"":"""+Результат.ИНН+""",""status"":""4""}";
	КонецЦикла;
	//Выборка = Справочники.Организации.Выбрать();
    //Выборка.Ссылка.
	retval="["+retval+"]";
	Возврат(retval);
