					Объект.ЮридическоеФизическоеЛицо		= Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
				Иначе
					Объект.ЮридическоеФизическоеЛицо		= Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
					Если vid=3 Тогда
						Объект.ОбособленноеПодразделение	= Истина;
						Если ЗначениеЗаполнено(mcontr) Тогда
							Объект.ГоловнойКонтрагент		= Справочники.Контрагенты.НайтиПоКоду(mcontr);
						КонецЕсли;
					ИначеЕсли vid=4 Тогда
						Объект.ГосударственныйОрган			= Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Попытка
				Объект.Записать();
				Попытка
					Если ЗначениеЗаполнено(uradr) Тогда
						Если стрДлина(uradr)>2 Тогда
							Адрес=Объект.КонтактнаяИнформация.Добавить();
        					Адрес.Тип=Перечисления.ТипыКонтактнойИнформации.Адрес;
        					Адрес.Вид=Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента; 
        					Адрес.Представление=Строка(uradr);
						КонецЕсли;
					КонецЕсли;
					Объект.Записать();
				Исключение
				КонецПопытки;
				//Если ЗначениеЗаполнено(Объект.Код) Тогда
			  	//retval="[{""retval"":""true"",""msg"":"""+Объект.Код+"""}]";
			  	retval="[{""retval"":""true"",""msg"":"""+Объект.Код+"""}]";
			Исключение
				retval="[{""retval"":""false"",""msg"":""Ошибка добавления клиента""}]";
			КонецПопытки;
		иначе
			retval="[{""retval"":""false"",""msg"":""Ошибка! Не заданы данные клиента: "+стрДлина(cname)+"|"+стрДлина(addname)+"|"+cstep+"""}]";
		КонецЕсли;
	КонецЕсли;
	Возврат(retval);
