//получить список номенклатуры заданной группы
Функция getNomenk(grpcode)
	Перем retval,sql,sqldop;
	retval="";
	sql = "
	|ВЫБРАТЬ 
	|	Номенклатура.Код КАК Код,Номенклатура.НаименованиеПолное КАК Наименование,
	|	Номенклатура.ЕдиницаИзмерения ЕИ, Номенклатура.ЕдиницаИзмерения.Ссылка.НаименованиеПолное ЕИП
	|ИЗ 
	|	Справочник.Номенклатура КАК Номенклатура ";
	Если стрДлина(grpcode)>0  Тогда
		sql=sql+" ГДЕ Номенклатура.Ссылка.Родитель.Код="""+grpcode+""" И Номенклатура.ПометкаУдаления = Ложь ";
	КонецЕсли;
	Запрос = Новый Запрос(sql); 
	Результат = Запрос.Выполнить().Выбрать(); 
	Пока Результат.Следующий() Цикл 
		Если стрДлина(retval)>0 Тогда
