Функция getClients(inn,name,grp,contrid,stat)
	Перем retval,sql,sqldop,сstat,toout,forclnt,dogs,accs;
	retval="";
	forclnt=0;
	//grp="Клиенты";
	Если стрДлина(inn)>0 ИЛИ стрДлина(name)>0 ИЛИ стрДлина(grp)>0 ИЛИ стрДлина(contrid)>0 Тогда
		sqldop=" ГДЕ ";
	КонецЕсли;
	sql = "
	|ВЫБРАТЬ 
	|	Контрагенты.Ссылка КАК Ссылка, Контрагенты.Код КАК Код, Контрагенты.Наименование КАК Наименование, 
	|   Контрагенты.ИНН КАК ИНН,
	|   Контрагенты.КПП КАК КПП,
	|   Контрагенты.ОбособленноеПодразделение,
	|   Контрагенты.ГосударственныйОрган,
	|   Контрагенты.ГоловнойКонтрагент.Код КАК ГоловнойКонтрагент ,
	|   Контрагенты.ЮридическоеФизическоеЛицо КАК ЮридическоеФизическоеЛицо, Контрагенты.ОсновнойБанковскийСчет.НомерСчета Как Счет, Контрагенты.НаименованиеПолное КАК НаименованиеПолное
	|ИЗ 
	|	Справочник.Контрагенты КАК Контрагенты ";
//    |     ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
//    |     ПО Контрагенты.Ссылка = БанковскиеСчета.Владелец
//	|ГДЕ Контрагенты.Родитель.Наименование = "+grp+" 
	Если стрДлина(inn)>0  Тогда
		Если стрДлина(sqldop)>стрДлина(" ГДЕ ") Тогда
			sqldop=sqldop+" И ";
		КонецЕсли;	
		sqldop=sqldop+" Контрагенты.ИНН="+inn+" ";
	КонецЕсли;
	Если стрДлина(name)>0  Тогда
		Если стрДлина(sqldop)>стрДлина(" ГДЕ ") Тогда
			sqldop=sqldop+" И ";
		КонецЕсли;	
		sqldop=sqldop+" Контрагенты.Наименование ПОДОБНО ""%"" + " + name + " + ""%"" ";
	КонецЕсли;
	Если стрДлина(grp)>0  Тогда
		Если стрДлина(sqldop)>стрДлина(" ГДЕ ") Тогда
			sqldop=sqldop+" И ";
		КонецЕсли;	
		sqldop=sqldop+" Контрагенты.Родитель.Наименование = "+grp+" ";
		Если grp = """Клиенты""" тогда
			forclnt=1;
		КонецЕсли;
	КонецЕсли;
	Если стрДлина(contrid)>0  Тогда
		Если стрДлина(sqldop)>стрДлина(" ГДЕ ") Тогда
			sqldop=sqldop+" И ";
		КонецЕсли;	
		sqldop=sqldop+" Контрагенты.Код = "+contrid+" ";
	КонецЕсли;
	sql = sql +sqldop;
	sql = sql +"
	|УПОРЯДОЧИТЬ ПО Код";
	Запрос = Новый Запрос(sql); 
	Результат = Запрос.Выполнить().Выбрать(); 
	Пока Результат.Следующий() Цикл 
		Если стрДлина(retval)>0 Тогда
			retval=retval+",";
		КонецЕсли;
		сstat = "0";
		toout = 1;
		Если Результат.Ссылка.ПометкаУдаления = Истина Тогда
			сstat = "1";
			Если stat>0 Тогда
				toout=0;
			КонецЕсли;
		КонецЕсли;
		Если toout>0 Тогда
			//добавляем договора клиента
			dogs = """dogs"":[";
			Договор = Справочники.ДоговорыКонтрагентов.Выбрать(,Результат.Ссылка,);
			колдог = 0;
			Пока Договор.Следующий() Цикл
				Если Договор.Ссылка.ПометкаУдаления = Ложь Тогда
					toadd=0;
					Если forclnt=1 Тогда
						Если Договор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
							toadd=1;
						КонецЕсли;
					Иначе
						toadd=1;
					КонецЕсли;
					Если toadd=1 Тогда
						Если колдог > 0 Тогда
							dogs = dogs+",";
						КонецЕсли;
						попытка
							dogs = dogs+"{""dognum"":"""+СтрЗаменить(СтрЗаменить(Договор.Номер,"\","\\"),"""","\""")+""",""dogdt"":"""+Договор.Дата+
							""",""orgname"":"""+СтрЗаменить(Договор.Ссылка.Организация,"""","\""")+
							""",""orgid"":"""+Договор.Ссылка.Организация.Ссылка.Код+
							""",""dogval"":"""+Договор.ВалютаВзаиморасчетов+
							""",""dogtype"":"""+Договор.ВидДоговора+""",""dogcode"":"""+Договор.Код+"""}";
							колдог = колдог+1;
						Исключение
							//retval="[{""retval"":""false"",""msg"":""Ошибка добавления группы договора""";
							dogs = dogs+"{""dognum"":"""+СтрЗаменить(СтрЗаменить(Договор.Номер,"\","\\"),"""","\""")+""",""dogdt"":"""+Договор.Дата+
							""",""orgname"":"""+СтрЗаменить(Договор.Ссылка.Организация,"""","\""")+
							""",""orgid"":"""+"!!!Err!!!"+
							""",""dogval"":"""+Договор.ВалютаВзаиморасчетов+
							""",""dogtype"":"""+Договор.ВидДоговора+""",""dogcode"":"""+Договор.Код+"""}";
							колдог = колдог+1;
						КонецПопытки;
					КонецЕсли;
					//dogs = dogs+"{""dognum"":"""+СтрЗаменить(Договор.Номер,"\\","/")+""",""dogdt"":"""+Договор.Дата+""",""orgid"":"""+Договор.Организация.Код+""",""dogtype"":"""+Договор.ВидДоговора+""",""dogcode"":"""+Договор.Код+"""}";
					//dogs = dogs+"{""dognum"":"""+СтрЗаменить(Договор.Номер,"\","\\")+""",""dogdt"":"""+Договор.Дата+""",""orgid"":"""+СтрЗаменить(Договор.Ссылка.Организация,"""","\""")+""",""dogtype"":"""+Договор.ВидДоговора+""",""dogcode"":"""+Договор.Код+"""}";
					//dogs = dogs+"{""dognum"":"""+Договор.Номер+""",""dogdt"":"""+Договор.Дата+""",""dogcode"":"""+Договор.Код+"""}";
				КонецЕсли;
			КонецЦикла;
			dogs = dogs+"]";
		    //добавляем банковские счета клиента
			accs = """accs"":[";
			Счета = Справочники.БанковскиеСчета.Выбрать(,Результат.Ссылка,);
			колдог = 0;
			Пока Счета.Следующий() Цикл
				сstata = "0";
				Если Счета.Ссылка.ПометкаУдаления = Ложь Тогда
					Если колдог > 0 Тогда
						accs = accs+",";
					КонецЕсли;
					accs = accs+"{""acc"":"""+Счета.НомерСчета+
					""",""swiftbic"":"""+Счета.Банк.Код+
					""",""bic"":"""+СтрЗаменить(Счета.Банк,"""","\""")+
					""",""acccode"":"""+Счета.Код+
					"""}";
					//accs = accs+"{""acc"":"""+Счета.НомерСчета+"""}";
					колдог = колдог+1;
				КонецЕсли;
			КонецЦикла;
			accs = accs+"]";
			retval=retval+
			"{""Код"":"""+Результат.Код+
			""",""ЮридическоеФизическоеЛицо"":"""+Результат.ЮридическоеФизическоеЛицо+
			""",""Наименование"":"""+СтрЗаменить(Результат.Наименование,"""","\""")+
			""",""ПолноеНаименование"":"""+СтрЗаменить(Результат.НаименованиеПолное,"""","\""")+
			""",""ИНН"":"""+Результат.ИНН+
			""",""КПП"":"""+Результат.КПП+
			""",""Счет"":"""+Результат.Счет+
			""",""ОП"":"""+Результат.ОбособленноеПодразделение+
			""",""ГО"":"""+Результат.ГосударственныйОрган+
			""",""ГК"":"""+Результат.ГоловнойКонтрагент+
			""",""Удален"":"""+сstat+""","+dogs+","+accs+"}";
		КонецЕсли;
	КонецЦикла;
//Выборка = Справочники.Контрагенты.Выбрать();
//Выборка.Ссылка.Родитель.Наименование=
	retval="["+retval+"]";
	Возврат(retval);
КонецФункции

Функция createDog(clntkod, orgkod, dognum, dogtype, dogname, dogdt, kodc, dogval)
	Перем retval,sql,curdog,curdogg,curdogch,curcl;
	retval="";
	//Попытка
	Если (стрДлина(clntkod)>0 И стрДлина(orgkod)>0) ИЛИ (стрДлина(kodc)>2) Тогда
		sql = "
		|ВЫБРАТЬ 
		|	ДоговорыКонтрагентов.Ссылка,
		|	ДоговорыКонтрагентов.Код КАК Код,  
		|   ДоговорыКонтрагентов.ВидДоговора КАК Тип
		|ИЗ 
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов 
		|ГДЕ ";
		Если стрДлина(kodc)>2 Тогда
			sql = sql+"
			|   ДоговорыКонтрагентов.ПометкаУдаления = Ложь И
			|   ДоговорыКонтрагентов.Код=&Код";
		Иначе
			sql = sql+"
			|   ДоговорыКонтрагентов.ПометкаУдаления = Ложь И
			|	ДоговорыКонтрагентов.ВидДоговора = &Вид И 
			|	ДоговорыКонтрагентов.Номер = &НомерДог И 
			|	ДоговорыКонтрагентов.Организация.Ссылка.Код = &Организация И 
			|   ДоговорыКонтрагентов.Владелец.Ссылка.Код = &Контрагент
			|	И ДоговорыКонтрагентов.Дата = &ДатаДог";
			//|	И ДоговорыКонтрагентов.Дата МЕЖДУ &НачДата И &КонДата";
		КонецЕсли;
		Запрос = Новый Запрос(sql);
		Если стрДлина(kodc)>2 Тогда
			Запрос.УстановитьПараметр("Код", kodc);
		Иначе
			Запрос.УстановитьПараметр("НомерДог", dognum);
			Запрос.УстановитьПараметр("Организация", orgkod);
			Запрос.УстановитьПараметр("Контрагент", clntkod);
    		Запрос.УстановитьПараметр("ДатаДог", dogdt);//Дата всегда на 00:00:00
			//Запрос.УстановитьПараметр("КонДата", КонецДня(dogdt));
			Запрос.УстановитьПараметр("Вид", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
		КонецЕсли;
		Результат = Запрос.Выполнить().Выбрать(); 
		//retval=sql+"|"+dognum+"|"+orgkod+"|"+clntkod+"|"+dogdt+"|"+КонецДня(dogdt);
		Если Результат.Следующий() Тогда
			Объект								= Результат.Ссылка.ПолучитьОбъект();
			Объект.СпособВыставленияДокументов	= Перечисления.СпособыВыставленияДокументов.Автоматически;
			Попытка
				Объект.Записать();
			Исключение
				retvl = ОписаниеОшибки();
			КонецПопытки;
			retval	= retval+"[{""retval"":""true"",""msg"":"""+Результат.Код+"""";
			Если dogtype=100 Тогда//если это договор клиентский
				curcl   = Справочники.Контрагенты.НайтиПоКоду(clntkod);
				curdogg=Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(dogname+"(гр)",,,curcl.Ссылка);
				cret = "";
				Если не curdogg.Пустая() тогда
					retval=retval+",""msgg"":"""+curdogg.Код+"""";
					curdogch=Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию("Открытые",,,curcl.Ссылка);
					Если не curdogch.Пустая() тогда
						retval=retval+",""msgo"":"""+curdogch.Код+"""";
					КонецЕсли;
					curdogchc=Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию("Закрытые",,,curcl.Ссылка);
					Если не curdogchc.Пустая() тогда
						retval=retval+",""msgc"":"""+curdogchc.Код+"""";
					КонецЕсли;
				иначе
					Попытка
						curdogg = Справочники.ДоговорыКонтрагентов.СоздатьГруппу();
						curdogg.Наименование=dogname+"(гр)";
						curdogg.Владелец = curcl.Ссылка;
						curdogg.Записать();
						cret = cret+"|"+curdogg.Наименование;
						
						curdogch = Справочники.ДоговорыКонтрагентов.СоздатьГруппу();
						curdogch.Наименование="Открытые";
						curdogch.Владелец = curcl.Ссылка;
						curdogch.Родитель = curdogg.Ссылка;
						curdogch.Записать();
						cret = cret+"|"+curdogg.Наименование;
						
						curdogchc=Справочники.ДоговорыКонтрагентов.СоздатьГруппу();
						curdogchc.Наименование="Закрытые";
						curdogchc.Владелец = curcl.Ссылка;
						curdogchc.Родитель = curdogg.Ссылка;
						curdogchc.Записать();
						cret = cret+"|"+curdogg.Наименование;
						retval=retval+",""msgg"":"""+curdogg.Код+
						       """,""msgo"":"""+curdogch.Код+""",""msgc"":"""+curdogchc.Код+"""";
					Исключение
						retval="[{""retval"":""false"",""msg"":""Ошибка добавления группы договора("+cret+")("+dogname+"|"+curcl.Ссылка+")|"+ОписаниеОшибки()+"""";
					КонецПопытки;
				конецесли;
			КонецЕсли;
			retval=retval+"}]";
		Иначе//создаем новый договор
			Объект								= Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			Объект.СпособВыставленияДокументов	= Перечисления.СпособыВыставленияДокументов.Автоматически;
    		Объект.Наименование					= dogname;
			Объект.Номер						= dognum;
			Объект.Дата							= dogdt;
			Если dogtype=1 Тогда
				Объект.ВидДоговора				= Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
			ИначеЕсли dogtype=2 Тогда
				Объект.ВидДоговора				= Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
			ИначеЕсли dogtype=3 Тогда
				Объект.ВидДоговора				= Перечисления.ВидыДоговоровКонтрагентов.СКомитентом;
			ИначеЕсли dogtype=4 Тогда
				Объект.ВидДоговора				= Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером;
			ИначеЕсли dogtype=5 Тогда
				Объект.ВидДоговора				= Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку;
			ИначеЕсли dogtype=6 Тогда
				Объект.ВидДоговора				= Перечисления.ВидыДоговоровКонтрагентов.СКомиссионеромНаЗакупку;
			ИначеЕсли dogtype=7 Тогда
				Объект.ВидДоговора				= Перечисления.ВидыДоговоровКонтрагентов.СФакторинговойКомпанией;
			ИначеЕсли dogtype=8 Тогда
				Объект.ВидДоговора				= Перечисления.ВидыДоговоровКонтрагентов.Прочее;
			ИначеЕсли dogtype=100 Тогда
				Объект.ВидДоговора				= Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
			КонецЕсли;
			Объект.ВалютаВзаиморасчетов			= Справочники.Валюты.НайтиПоКоду(dogval);
			Если Не dogval=643 тогда
				Объект.СпособЗаполненияСтавкиНДС	=	Перечисления.СпособыЗаполненияСтавкиНДС.БезНДС;
				Объект.СпособВыставленияДокументов	=	Перечисления.СпособыВыставленияДокументов.Автоматически;
			Иначе
				Объект.СпособЗаполненияСтавкиНДС	=	Перечисления.СпособыЗаполненияСтавкиНДС.Автоматически;
				Объект.СпособВыставленияДокументов	=	Перечисления.СпособыВыставленияДокументов.Автоматически;
			КонецЕсли;
    		Объект.РасчетыВУсловныхЕдиницах		= Ложь;
    		Объект.Организация					= Справочники.Организации.НайтиПоКоду(orgkod);
    		Объект.Владелец						= Справочники.Контрагенты.НайтиПоКоду(clntkod);
			Попытка
				Объект.Записать();
				retval=retval+"[{""retval"":""true"",""msg"":"""+Объект.Код+"""";
				Если dogtype=100 Тогда//если это договор клиентский
					curdogg=Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(dogname+"(гр)");
					Если не curdogg.Пустая() тогда
						retval=retval+",""msgg"":"""+curdogg.Код+"""";
					иначе
						Попытка
							curcl   = Справочники.Контрагенты.НайтиПоКоду(clntkod);
							curdogg = Справочники.ДоговорыКонтрагентов.СоздатьГруппу();
							curdogg.Наименование=dogname+"(гр)";
							curdogg.Владелец = curcl.Ссылка;
							curdogg.Записать();
							
							curdogch = Справочники.ДоговорыКонтрагентов.СоздатьГруппу();
							curdogch.Наименование="Открытые";
							curdogch.Владелец = curcl.Ссылка;
							curdogch.Родитель = curdogg.Ссылка;
							curdogch.Записать();
								
							curdogch=Справочники.ДоговорыКонтрагентов.СоздатьГруппу();
							curdogch.Наименование="Закрытые";
							curdogch.Владелец = curcl.Ссылка;
							curdogch.Родитель = curdogg.Ссылка;
							curdogch.Записать();
							retval=retval+",""msgg"":"""+curdogg.Код+"""";
						Исключение
							retval="[{""retval"":""false"",""msg"":""Ошибка добавления группы договора""";
						КонецПопытки;
					конецесли;
				КонецЕсли;
				retval=retval+"}]";
			Исключение
				retval=retval+"[{""retval"":""false"",""msg"":""Ошибка добавления договора""}]";
			КонецПопытки;
		КонецЕсли;
		//КонецЕсли;
	Иначе
		retval="[{""retval"":""false"",""msg"":""Не указаны входные параметры""}]";
	КонецЕсли;
	//Исключение
	//	retval="[{""retval"":""false"",""msg"":"""+clntkod+","+orgkod+","+dognum+","+dogtype+","+dogname+","+dogdt+"""}]";
	//КонецПопытки;
	Возврат(retval);
КонецФункции

Функция clsSpec(kodcb)
	Перем retval,sql,curdogg,curdogd,Запрос,Результат;
	retval="";
	Если стрДлина(kodcb)>0 Тогда
		sql = "
			|ВЫБРАТЬ 
			|	ДоговорыКонтрагентов.Код КАК Код,
			|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
			|   ДоговорыКонтрагентов.ВидДоговора КАК Тип
			|ИЗ 
			|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов 
			|ГДЕ 
			|   ДоговорыКонтрагентов.Код=&Код";
		Запрос = Новый Запрос(sql);
		Запрос.УстановитьПараметр("Код", kodcb);
		Результат = Запрос.Выполнить().Выбрать(); 
		Если Результат.Следующий() Тогда
			Если Результат.Ссылка.Родитель.Родитель.Наименование = "Открытые" Тогда
				curdogd = Справочники.ДоговорыКонтрагентов.НайтиПокоду(Результат.Ссылка.Родитель.Родитель.Родитель.Код);
				Если не curdogd.Пустая() тогда
					curdogch=Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию("Закрытые",,curdogd,);
					Если не curdogch.Пустая() тогда
						Попытка
						//	cdogb = Справочники.ДоговорыКонтрагентов.НайтиПокоду(kodcb);
						//	cdogb = cdogb.ПолучитьОбъект();
						//	cdogb.Родитель = curdogch.Ссылка;
						//	cdogb.Записать();
							
						//	cdogp = Справочники.ДоговорыКонтрагентов.НайтиПокоду(kodcp);
						//	cdogp = cdogp.ПолучитьОбъект();
						//	cdogp.Родитель = curdogch.Ссылка;
						//	cdogp.Записать();
							
							cdoggo = Справочники.ДоговорыКонтрагентов.НайтиПокоду(Результат.Ссылка.Родитель.Код);
							cdoggo = cdoggo.ПолучитьОбъект();
							cdoggo.Родитель = curdogch.Ссылка;
							cdoggo.Записать();
							
						//	cdoggo = Справочники.ДоговорыКонтрагентов.НайтиПокоду(Результат.Ссылка.Родитель.Родитель.Код);
						//	cdogb.Родитель = cdoggo.Ссылка;
						//	cdogb.Записать();
							
						//	cdogp.Родитель = cdoggo.Ссылка;
						//	cdogp.Записать();
							retval="[{""retval"":""true"",""msg"":""Cпецификация перенесена в закрытые""}]";
						Исключение
							retval="[{""retval"":""false"",""msg"":""Ошибка переноса спецификации в закрытые "+ОписаниеОшибки()+"""}]";
						КонецПопытки;
					Иначе
						retval="[{""retval"":""false"",""msg"":""Не найдена группа закрытых для спецификации""}]";
					КонецЕсли;
				Иначе
					retval="[{""retval"":""false"",""msg"":""Не найдена группа договоров по спецификации""}]";
				КонецЕсли;
			Иначе
				retval="[{""retval"":""false"",""msg"":""Спецификация не найдена в открытых""}]";
			КонецЕсли;
		Иначе
			retval="[{""retval"":""false"",""msg"":""Не найдена спецификация("+kodcb+")""}]";
		КонецЕсли;
	Иначе
		retval="[{""retval"":""false"",""msg"":""Не указан код спецификации("+kodcb+")""}]";
	КонецЕсли;
	Возврат(retval);
КонецФункции	

Функция createSpec(clntkod, orgkod, specnum, specname, specdt, pdogcode, dognum, dirname, kodc, subtype, kodcb)
	Перем retval,sql,curdog,curdogch,curdogchn,curcl,msgr;
	retval="";
	msgr="";
	redescr="";
	Если стрДлина(dognum)>0 И стрДлина(specnum)>0 И стрДлина(clntkod)>0 Тогда
		sql = "
		|ВЫБРАТЬ 
		|	ДоговорыКонтрагентов.Ссылка,
		|	ДоговорыКонтрагентов.Код КАК Код,  
		|   ДоговорыКонтрагентов.ВидДоговора КАК Тип
		|ИЗ 
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов 
		|ГДЕ ";
		Если стрДлина(kodc)>2 Тогда//код договора с принципалом
			sql = sql+"
			|   ДоговорыКонтрагентов.ПометкаУдаления = Ложь И
			|   ДоговорыКонтрагентов.Код=&Код";
		Иначе
			sql = sql+"
			|   ДоговорыКонтрагентов.ПометкаУдаления = Ложь И
			|	ДоговорыКонтрагентов.ВидДоговора = &Вид И 
			|	ДоговорыКонтрагентов.Номер = &НомерДог И 
			|	ДоговорыКонтрагентов.Организация.Ссылка.Код = &Организация И 
			|   ДоговорыКонтрагентов.Владелец.Ссылка.Код = &Контрагент
			|	И ДоговорыКонтрагентов.Дата = &ДатаДог";
		КонецЕсли;
		Запрос = Новый Запрос(sql);
		Если стрДлина(kodc)>2 Тогда
			Запрос.УстановитьПараметр("Код", kodc);
		Иначе
			Запрос.УстановитьПараметр("НомерДог", dognum+"/"+specnum);
			Запрос.УстановитьПараметр("Организация", orgkod);
			Запрос.УстановитьПараметр("Контрагент", clntkod);
    		Запрос.УстановитьПараметр("ДатаДог", specdt);//Дата всегда на 00:00:00
			//Запрос.УстановитьПараметр("КонДата", КонецДня(dogdt));
			Запрос.УстановитьПараметр("Вид", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
			//Если subtype=2 или subtype=5 или subtype=6 тогда
			//	Запрос.УстановитьПараметр("Вид", Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку);
			//Иначе
			//	Запрос.УстановитьПараметр("Вид", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
			//КонецЕсли;
		КонецЕсли;
		Результат = Запрос.Выполнить().Выбрать(); 
		Если Результат.Следующий() Тогда
			Объект								= Результат.Ссылка.ПолучитьОбъект();
			Объект.СпособВыставленияДокументов	= Перечисления.СпособыВыставленияДокументов.Автоматически;
			Попытка
				Объект.Записать();
			Исключение
				retvl = ОписаниеОшибки();
			КонецПопытки;
			Если стрДлина(kodcb)>0 Тогда//код договора с покупателем
				sql = "
				|ВЫБРАТЬ 
				|	ДоговорыКонтрагентов.Ссылка
				|ИЗ 
				|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов 
				|ГДЕ 
				|   ДоговорыКонтрагентов.ПометкаУдаления = Ложь И
				|   ДоговорыКонтрагентов.Код=&Код";
				Запрос = Новый Запрос(sql);
				Запрос.УстановитьПараметр("Код", kodcb);
				Результат = Запрос.Выполнить().Выбрать(); 
				Если Результат.Следующий() Тогда
					Объект								= Результат.Ссылка.ПолучитьОбъект();
					Объект.СпособВыставленияДокументов	= Перечисления.СпособыВыставленияДокументов.Автоматически;
					Попытка
						Объект.Записать();
					Исключение
						retvl = retvl+"|"+ОписаниеОшибки();
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
			retval="[{""retval"":""false"",""msg"":""Спецификация присутствует в 1С""}]";
		иначе
			curcl   = Справочники.Контрагенты.НайтиПоКоду(clntkod);
			Если не curcl.Пустая() тогда
				curdog=Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(dirname,,,curcl.Ссылка);
				Если не curdog.Пустая() тогда
					curdogch=Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию("Открытые",,curdog.Ссылка,curcl.Ссылка);
					Если не curdogch.Пустая() тогда
						curdogchn = Справочники.ДоговорыКонтрагентов.СоздатьГруппу();
						Если subtype=1 тогда
							curdogchn.Наименование="Сертификация № "+specnum;
						ИначеЕсли subtype=5 тогда
							curdogchn.Наименование="Заявка № "+specnum;
						ИначеЕсли subtype=3 тогда
							curdogchn.Наименование="Заявка № "+specnum;
						ИначеЕсли subtype=4 тогда
							curdogchn.Наименование="Заявка ТП № "+specnum;
						Иначе
							curdogchn.Наименование="Спецификация № "+specnum;
						КонецЕсли;
						curdogchn.Владелец = curcl.Ссылка;
						curdogchn.Родитель = curdogch.Ссылка;
						Попытка
							curdogchn.Записать();
							Если стрДлина(msgr)>0 Тогда msgr=msgr+","; КонецЕсли;
							msgr = msgr+"""specgrn"":"""+curdogchn.Код+"""";
							redescr = redescr+"Создали папку для спецификации. ";
							Объект 								= Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
							Объект.СпособВыставленияДокументов	= Перечисления.СпособыВыставленияДокументов.Автоматически;
   							Объект.Наименование           = specname;
							Если subtype=1 тогда
								Объект.Номер                  = dognum+"/"+specnum+" серт";
							Иначе
								Объект.Номер                  = dognum+"/"+specnum;
							КонецЕсли;
							Объект.Дата                   = specdt;
							Объект.ВидДоговора            = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
   							Объект.РасчетыВУсловныхЕдиницах = Ложь;
   							Объект.Организация            = Справочники.Организации.НайтиПоКоду(orgkod);
   							Объект.Владелец               = curcl.Ссылка;
							Объект.Родитель               = curdogchn.Ссылка;
							Объект.ВалютаВзаиморасчетов   = Справочники.Валюты.НайтиПоКоду(643);
							Попытка
								Объект.Записать();
								Если стрДлина(msgr)>0 Тогда msgr=msgr+","; КонецЕсли;
								msgr = msgr+"""specb"":"""+Объект.Код+"""";
								redescr = redescr+"Создали договор с покупателем. ";
								НаборЗаписей = РегистрыСведений.СчетаУчетаРасчетовСКонтрагентами.СоздатьНаборЗаписей();
								НаборЗаписей.Отбор.Организация.Установить(Объект.Организация); 
								НаборЗаписей.Отбор.Контрагент.Установить(Объект.Владелец);
								НаборЗаписей.Отбор.Договор.Установить(Объект.Ссылка);
								НоваяЗапись = НаборЗаписей.Добавить();
								НоваяЗапись.Организация                   = Объект.Организация;
								НоваяЗапись.Контрагент                    = Объект.Владелец;
								НоваяЗапись.Договор                       = Объект.Ссылка;
								НоваяЗапись.ВидРасчетовПоДоговору         = Перечисления.ВидыРасчетовПоДоговорам.РасчетыВВалютеРегламентированногоУчета;
								НоваяЗапись.СчетУчетаРасчетовСПокупателем = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01");
								НоваяЗапись.СчетУчетаАвансовПолученных    = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.02");
								Попытка
									НаборЗаписей.Записать();
									Если стрДлина(msgr)>0 Тогда msgr=msgr+","; КонецЕсли;
									msgr = msgr+"""specbd"":""1""";
									redescr = redescr+"Договору с покупателем выставили параметры. ";
								Исключение
									redescr = redescr+"Ошибка добавления параметров договору с покупателем "+ОписаниеОшибки()+". ";	
								КонецПопытки;
							Исключение
								redescr = redescr+"Ошибка создания договора с покупателем. ";	
							КонецПопытки;
							Если subtype=2 или subtype=5 или subtype=6 тогда
								Объект1								= Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
								Объект1.СпособВыставленияДокументов	= Перечисления.СпособыВыставленияДокументов.Автоматически;
	   							Объект1.Наименование           = specname;
								Объект1.Номер                  = dognum+"/"+specnum;
								Объект1.Дата                   = specdt;
								Объект1.ВидДоговора            = Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку;
	   							Объект1.РасчетыВУсловныхЕдиницах = Ложь;
   								Объект1.Организация            = Справочники.Организации.НайтиПоКоду(orgkod);
	   							Объект1.Владелец               = curcl.Ссылка;
								Объект1.Родитель               = curdogchn.Ссылка;
								Объект1.ВалютаВзаиморасчетов   = Справочники.Валюты.НайтиПоКоду(643);
								Попытка
									Объект1.Записать();
									Если стрДлина(msgr)>0 Тогда msgr=msgr+","; КонецЕсли;
									msgr = msgr+"""speca"":"""+Объект1.Код+"""";
									redescr = redescr+"Создали агентский договор. ";
									НаборЗаписей1 = РегистрыСведений.СчетаУчетаРасчетовСКонтрагентами.СоздатьНаборЗаписей();
									НаборЗаписей1.Отбор.Организация.Установить(Объект1.Организация); 
									НаборЗаписей1.Отбор.Контрагент.Установить(Объект1.Владелец);
									НаборЗаписей1.Отбор.Договор.Установить(Объект1.Ссылка);
									НоваяЗапись1 = НаборЗаписей1.Добавить();
									НоваяЗапись1.Организация                   = Объект1.Организация;
									НоваяЗапись1.Контрагент                    = Объект1.Владелец;
									НоваяЗапись1.Договор                       = Объект1.Ссылка;
									НоваяЗапись1.ВидРасчетовПоДоговору         = Перечисления.ВидыРасчетовПоДоговорам.РасчетыВВалютеРегламентированногоУчета;
									НоваяЗапись1.СчетУчетаРасчетовСПокупателем = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.06");
									НоваяЗапись1.СчетУчетаАвансовПолученных    = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.06");
									Попытка
										НаборЗаписей1.Записать();
										Если стрДлина(msgr)>0 Тогда msgr=msgr+","; КонецЕсли;
										msgr = msgr+"""specad"":""1""";
										redescr = redescr+"Агентскому договору выставили параметры. ";
									Исключение
										redescr = redescr+"Ошибка добавления параметров агентскому договору "+ОписаниеОшибки()+". ";	
									КонецПопытки;
								Исключение
									redescr = redescr+"Ошибка создания агентского договора "+ОписаниеОшибки()+".";	
								КонецПопытки;
							КонецЕсли;
							retval="[{""retval"":""true"",""msgr"":{"+msgr+"},""descr"":"""+redescr+"""}]";
						Исключение
							retval="[{""retval"":""false"",""msg"":""Ошибка добавления папки для спецификации "+ОписаниеОшибки()+"""}]";
						КонецПопытки;
					иначе
						retval="[{""retval"":""false"",""msg"":""Не найден раздел открытых спецификаций по договору в 1С""}]";
					КонецЕсли;
				иначе
					retval="[{""retval"":""false"",""msg"":""Не найден договор по спецификации в 1С ("+dirname+"/"+clntkod+"/"+curcl.Ссылка+")""}]";
				КонецЕсли;
			Иначе
				retval="[{""retval"":""false"",""msg"":""Не найден клиент в 1С ("+clntkod+")""}]";
			КонецЕсли;
		КонецЕсли;
	Иначе
		retval="[{""retval"":""false"",""msg"":""Не указан номер спецификации, договора или клиента ("+dirname+"/"+specnum+"/"+clntkod+")""}]";
	КонецЕсли;
	Возврат(retval);
КонецФункции

Функция createClient(cname, addname, cgroup, inn, ogrn, kpp, uradr, vid, mcontr, clcntrreg, nalognumber)
	Перем retval,sql,currec,clcod,cstep,sql1;
	cstep=0;
	retval="";
	retv = "";
	cname = СтрЗаменить(cname,"&amp;","&");
	addname = СтрЗаменить(addname,"&amp;","&");
	//Если ЗначениеЗаполнено(inn) Тогда
	Если стрДлина(inn)>9 Тогда//если есть ИНН
		cstep=1;
		sql1= " И Контрагенты.ИНН = &ИНН";
	ИначеЕсли стрДлина(cname)>2 Тогда
		cstep=2;
		sql1= " И Контрагенты.Наименование = &Наименование";
	ИначеЕсли стрДлина(addname)>2 Тогда
		cstep=3;
		sql1= " И Контрагенты.НаименованиеПолное = &НаименованиеПолное";
	КонецЕсли;
	Если cstep>0 Тогда
		sql = "
		|ВЫБРАТЬ 
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ 
		|	Справочник.Контрагенты КАК Контрагенты 
		|ГДЕ Контрагенты.ПометкаУдаления = Ложь ";
		sql = sql+sql1;
		Запрос = Новый Запрос(sql); 
		Если cstep=1 Тогда
			Запрос.УстановитьПараметр("ИНН", inn);
		ИначеЕсли cstep=2 Тогда
			Запрос.УстановитьПараметр("Наименование", cname);
		ИначеЕсли cstep=3 Тогда
			Запрос.УстановитьПараметр("НаименованиеПолное", addname);
		КонецЕсли;
		Результат = Запрос.Выполнить().Выбрать(); 
		Если Результат.Следующий() Тогда
			КонтрагентСсылка = Результат.Ссылка.ПолучитьОбъект();
			Если стрДлина(cname)>2 Тогда
				КонтрагентСсылка.Наименование = cname;
			КонецЕсли;
			Если стрДлина(addname)>2 Тогда
				КонтрагентСсылка.НаименованиеПолное = addname;
			КонецЕсли;
			Если ЗначениеЗаполнено(kpp) Тогда
				Если стрДлина(kpp)>2 Тогда
					КонтрагентСсылка.КПП = kpp;
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(ogrn) Тогда
				Если стрДлина(ogrn)>2 Тогда
					КонтрагентСсылка.РегистрационныйНомер = ogrn;
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(vid) Тогда
				Если vid=2 Тогда
					КонтрагентСсылка.ЮридическоеФизическоеЛицо		= Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
				Иначе
					КонтрагентСсылка.ЮридическоеФизическоеЛицо		= Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
					Если vid=3 Тогда
						КонтрагентСсылка.ОбособленноеПодразделение	= Истина;
						Если ЗначениеЗаполнено(mcontr) Тогда
							КонтрагентСсылка.ГоловнойКонтрагент		= Справочники.Контрагенты.НайтиПоКоду(mcontr);
						КонецЕсли;
					ИначеЕсли vid=4 Тогда
						КонтрагентСсылка.ГосударственныйОрган		= Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(uradr) Тогда
