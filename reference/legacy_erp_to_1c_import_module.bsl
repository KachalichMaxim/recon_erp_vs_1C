						""",""period"":"""+Формат(Результат.ДатаНачала, "ДФ='dd.MM.yyyy'")+" - "+Формат(Результат.ДатаОкончания, "ДФ='dd.MM.yyyy'")+
						""",""org"":"""+СтрЗаменить(Результат.Организация,"""","\""")+
						""",""signed"":"""+Результат.Подписан+
						""",""buh"":"""+Результат.Ответственный+
						""",""kod1c"":"""+Результат.Номер+
						""",""dt1c"":"""+Результат.Дата+
						""",""guid"":"""+УИН+"""}";
				КонецЕсли;
			КонецЦикла;	
		//Иначе
		//	retval="[{""retval"":""false"",""msg"":""Ошибка, не найден контрагент ("+org+","+clnt+","+dtb+","+dte+")""}]";
		КонецЕсли;
