//добавить/обновить Реализация (акты, накладные, УПД)
Функция addupdAktR(okod, ckod, dkod, numc, dtc, comm, dsum, dval, vnds, vozmc, dparm, dopstr, op)
	Перем usl,ЧтениеДЖ,МассивДжи,sql,descr,astat,УИН;
	astat=0;
	УИН="";
	Если стрДлина(okod)>0 И стрДлина(ckod)>0 И стрДлина(dkod)>0 И стрДлина(dparm)>0 И dsum>0 Тогда
		descr   = "";
		orgid   = Справочники.Организации.НайтиПоКоду(okod);
		contrid = Справочники.Контрагенты.НайтиПоКоду(ckod);
		dogid	= Справочники.ДоговорыКонтрагентов.НайтиПоКоду(dkod);
		dopansw = orgid.Код+"_"+contrid.Код+"_"+dogid.Код;
		sql = "
		|ВЫБРАТЬ 
		| РеализацияТоваровУслуг.Ссылка
		|ИЗ
		| Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		| РеализацияТоваровУслуг.ПометкаУдаления = ЛОЖЬ И
		| РеализацияТоваровУслуг.Номер = &Номер
		| И РеализацияТоваровУслуг.Дата МЕЖДУ &НачДата И &КонДата
		| И РеализацияТоваровУслуг.Организация = &Организация 
		| И РеализацияТоваровУслуг.Контрагент = &Контрагент
		|";
		Запрос = Новый Запрос(sql); 
		Запрос.УстановитьПараметр("Номер", numc);
		Запрос.УстановитьПараметр("НачДата",  dtc);
   		Запрос.УстановитьПараметр("КонДата",  КонецДня(dtc));
		Запрос.УстановитьПараметр("Организация", orgid.Ссылка);
		Запрос.УстановитьПараметр("Контрагент" , contrid.Ссылка);
		Результат = Запрос.Выполнить().Выбрать(); 
		Если Результат.Следующий() Тогда//нашли АКТ, обновляем
			Объект	= Результат.Ссылка.ПолучитьОбъект();
		Иначе//создаем новый
			Объект	= Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		КонецЕсли;
		Объект.Номер					= numc;
		Объект.Дата						= dtc;
		Объект.Организация				= orgid;
		Объект.Контрагент				= contrid;
		Объект.ДоговорКонтрагента		= dogid;
		Если стрДлина(dopstr)>1 Тогда
			Объект.Комментарий	= dopstr;
		ИначеЕсли стрДлина(comm)>1 Тогда
		Иначе
			Объект.Комментарий	= "Счёт создан при импорте.";
		КонецЕсли;
		Объект.СуммаДокумента			= dsum;
		Объект.ВалютаДокумента			= Справочники.Валюты.НайтиПоКоду(dval);
		//Объект.ПодразделениеОрганизации = Справочники.ПодразделенияОрганизаций.НайтиПоНаименованию("ОП",Истина);
		descr = descr+" Подразделение: "+op+" ";
		//descr = descr+" Подразделение: "+op+"_|_"+Объект.ВалютаДокумента+"_|";
		Объект.ПодразделениеОрганизации = Справочники.ПодразделенияОрганизаций.НайтиПоНаименованию(op,Истина,,Объект.Организация);
		//Объект.СуммаВключаетНДС			= Ложь;
		//Объект.ДокументБезНДС           = Истина;
		Объект.СуммаВключаетНДС			= Истина;
		Если vnds>0 Тогда
			Объект.СуммаВключаетНДС		= Истина;
			//Объект.ДокументБезНДС		= Ложь;
		КонецЕсли;
		Объект.СпособЗачетаАвансов              = Перечисления.СпособыЗачетаАвансов.Автоматически;
		Объект.СчетУчетаРасчетовСКонтрагентом	= ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01");
		Объект.СчетУчетаРасчетовПоАвансам		= ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.02");
		Если  vozmc=1 Тогда
			Объект.ВидОперации			= Перечисления.ВидыОперацийРеализацияТоваров.Товары;
		ИначеЕсли  vozmc=2 Тогда
			Объект.ВидОперации			= Перечисления.ВидыОперацийРеализацияТоваров.Услуги;
		Иначе  
			Объект.ВидОперации			= Перечисления.ВидыОперацийРеализацияТоваров.Услуги;
		КонецЕсли;
		Объект.КурсВзаиморасчетов		= 1;
		ТабЧасть = Объект.Услуги;
		ТабЧасть.Очистить();
		ТабЧасть = Объект.АгентскиеУслуги;
    	ТабЧасть.Очистить();
		ЧтениеДЖ 					= Новый ЧтениеJSON;
    	ЧтениеДЖ.УстановитьСтроку(dparm);
    	МассивДжи 					= ПрочитатьJSON(ЧтениеДЖ);
		ЧтениеДЖ.Закрыть();
		сндс = 0;
		Для каждого usl из МассивДжи Цикл
			Если usl.izvozm="1" Тогда
				ТабЧасть							= Объект.АгентскиеУслуги.Добавить();
				ТабЧасть.Содержание					= usl.detdescr;
				ТабЧасть.Контрагент					= contrid;
				ТабЧасть.ДоговорКонтрагента			= dogid;
				ТабЧасть.СчетРасчетов				= ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.06");
			ИначеЕсли usl.izvozm="2" Тогда
				ТабЧасть	= Объект.Услуги.Добавить();
				ТабЧасть.Содержание					= usl.detdescr;
				ТабЧасть.СчетДоходов				= ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.01.1");
				ТабЧасть.СчетРасходов				= ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.02.1");
				ТабЧасть.СчетУчетаНДСПоРеализации	= ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.03");
				Если стрДлина(usl.nomenkgroup)>1 Тогда
					ТабЧасть.Субконто				= Справочники.НоменклатурныеГруппы.НайтиПоНаименованию(usl.nomenkgroup);
				Иначе
					ТабЧасть.Субконто				= Справочники.НоменклатурныеГруппы.НайтиПоНаименованию("Агентское вознаграждение");
				КонецЕсли;
			ИначеЕсли usl.izvozm="3" Тогда
				ТабЧасть	= Объект.Товары.Добавить();
				ТабЧасть.СчетУчета					= ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01");
				ТабЧасть.СчетДоходов				= ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.01.1");
				ТабЧасть.СчетРасходов				= ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.02.1");
				ТабЧасть.СчетУчетаНДСПоРеализации	= ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.03");
				ТабЧасть.СтранаПроисхождения		= Справочники.СтраныМира.НайтиПоКоду(usl.detcountry);
				ТабЧасть.НомерГТД					= Справочники.НомераГТД.НайтиПоКоду(usl.dettdnum);
			КонецЕсли;
			//Попытка
				ТабЧасть.Номенклатура 	= Справочники.Номенклатура.НайтиПоКоду(usl.detnomenk);
			//Исключение
			//	descr = descr+"Не найдена код "+usl.detnomenk+" номенклатуры ";
			//КонецПопытки;
			ТабЧасть.Количество     = usl.detcol;
			ТабЧасть.Цена		    = usl.detsum;
			ТабЧасть.Сумма		    = usl.detsum;
			Если usl.detnds="0" Тогда
				ТабЧасть.Сумма		= usl.detsum;
				ТабЧасть.СтавкаНДС	= Перечисления.СтавкиНДС.БезНДС;
				ТабЧасть.СуммаНДС	= 0;
			ИначеЕсли usl.detnds="1" Тогда
				ТабЧасть.Сумма		= usl.detsum;
				ТабЧасть.СтавкаНДС	= Перечисления.СтавкиНДС.НДС10;
				ТабЧасть.СуммаНДС	= usl.detsum*10/110;
				сндс=1;
			ИначеЕсли usl.detnds="2" Тогда
				ТабЧасть.Сумма		= usl.detsum;
				ТабЧасть.СтавкаНДС	= Перечисления.СтавкиНДС.НДС20;
				ТабЧасть.СуммаНДС	= usl.detsum*20/120;
				сндс=1;
			ИначеЕсли usl.detnds="3" Тогда
				ТабЧасть.Сумма		= usl.detsum;
				ТабЧасть.СтавкаНДС	= Перечисления.СтавкиНДС.НДС0;
				ТабЧасть.СуммаНДС		= 0;
			ИначеЕсли usl.detnds="4" Тогда
				ТабЧасть.Сумма		= usl.detsum;
				ТабЧасть.СтавкаНДС	= Перечисления.СтавкиНДС.НДС5;
				ТабЧасть.СуммаНДС	= usl.detsum*5/105;
				сндс=1;
			ИначеЕсли usl.detnds="5" Тогда
				ТабЧасть.Сумма		= usl.detsum;
				ТабЧасть.СтавкаНДС	= Перечисления.СтавкиНДС.НДС7;
				ТабЧасть.СуммаНДС	= usl.detsum*7/107;
				сндс=1;
			ИначеЕсли usl.detnds="6" Тогда
				ТабЧасть.Сумма		= usl.detsum;
				ТабЧасть.СтавкаНДС	= Перечисления.СтавкиНДС.НДС22;
				ТабЧасть.СуммаНДС	= usl.detsum*22/122;
				сндс=1;
			Иначе
				ТабЧасть.Сумма		= usl.detsum;
				ТабЧасть.СтавкаНДС	= Перечисления.СтавкиНДС.БезНДС;
				ТабЧасть.СуммаНДС		= 0;				
			КонецЕсли;
		КонецЦикла;
		Если сндс>0 Тогда
			Объект.СуммаВключаетНДС		= Истина;
			//Объект.ДокументБезНДС		= Ложь;
		КонецЕсли;
		Попытка
			Объект.Записать();
			descr = descr+"Документ записан. ";
			УИН = Строка(Объект.Ссылка.УникальныйИдентификатор());
			astat=1;
			Попытка
				Объект.Записать(РежимЗаписиДокумента.Проведение);
				descr = descr+"Документ проведен.";
				astat=2;
			Исключение
				retval="{""retval"":""false"",""c1guid"":"""+УИН+""",""status"":"""+astat+""",""msg"":""Ошибка проведения акта: "+dogid+"_"+СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(ОписаниеОшибки(),"""","'"),"}",")"),"{","("),Символы.ПС," "),Символы.Таб," "),Символы.ВК," ")+"""}";
			КонецПопытки;
			descr = "("+descr+")";
			retval="{""retval"":""true"",""c1guid"":"""+УИН+""",""msg"":"""+Объект.Номер+""",""status"":"""+astat+""",""descr"":"""+descr+"""}";
		Исключение
			retval="{""retval"":""false"",""c1guid"":"""+УИН+""",""status"":"""+astat+""",""msg"":""Ошибка создания/обновления акта: "+dopansw+"|"+dogid+"_"+СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(ОписаниеОшибки(),"""","'"),"}",")"),"{","("),Символы.ПС," "),Символы.Таб," "),Символы.ВК," ")+"""}";
		КонецПопытки;
	Иначе
		retval="{""retval"":""false"",""c1guid"":"""+УИН+""",""status"":"""+astat+""",""msg"":""Отсутствуют параметры документа""}";
	КонецЕсли;
	Возврат(retval);
КонецФункции

//создать операции, введенные в ручную по курсовым разницам, возникшим при валютных переводах и в конце месяца
Функция addupdDifRateVTr(okodc, drdt, tn, dsum, tchjs, drkodc)
	Перем retval,sql,org,usl,ЧтениеДЖ,МассивДжи,ТабЧСч,retmsg,fd,дв;
	fd=0;
	дв=0;
	retval="";
	Попытка
		Если стрДлина(drkodc)>0 Тогда
			sql = "
			|ВЫБРАТЬ 
			|    Док.Ссылка
    		|ИЗ
			|    Документ.ОперацияБух КАК Док
    		|ГДЕ
			|    Док.Дата МЕЖДУ &НачДата И &КонДата
			|    И Док.Номер = &Номер
    		|    И Док.Организация = &Организация
    		|";
			org = Справочники.Организации.НайтиПоКоду(okodc);
			Если не org.Пустая() Тогда
				Запрос = Новый Запрос(sql); 
				Запрос.УстановитьПараметр("НачДата", drdt);//Дата всегда на 00:00:00
				Запрос.УстановитьПараметр("КонДата", КонецДня(drdt));
				Запрос.УстановитьПараметр("Номер", drkodc);
				Запрос.УстановитьПараметр("Организация", org.Ссылка);
				Результат = Запрос.Выполнить().Выбрать(); 
				Если Результат.Следующий() Тогда
					ДокОперации = Результат.Ссылка.ПолучитьОбъект();
					ДокОперации.УстановитьПометкуУдаления(Ложь);
					ДокОперации.Движения.Хозрасчетный.Очистить();
					retval = "Нашли документ";
					fd=1;
				КонецЕсли;
			КонецЕсли;
		Иначе
			retval = "Создали документ. ";
			ДокОперации = Документы.ОперацияБух.СоздатьДокумент();
			fd=1;
		КонецЕсли;
	Исключение
		retval = "Ошибка поиска/создания документ: "+ОписаниеОшибки()+". ";
	КонецПопытки;
	Если fd=1 Тогда
		org = Справочники.Организации.НайтиПоКоду(okodc);
		Если не org.Пустая() Тогда
			ДокОперации.Организация = org.Ссылка;
		КонецЕсли;
		ДокОперации.Дата = drdt;
		ДокОперации.Содержание = tn;
		ДокОперации.Ответственный = Пользователи.ТекущийПользователь();
		ДокОперации.СпособЗаполнения = "Вручную";
		Попытка
			ДокОперации.Записать();
		    retval = retval+"Записали документ. ";
			СтруктураШапкиДокумента = Новый Структура;
			СтруктураШапкиДокумента.Вставить("Организация", org.Ссылка);
			СтруктураШапкиДокумента.Вставить("Дата", drdt);
			СистемаНО 	= УчетнаяПолитика.СистемаНалогообложения(СтруктураШапкиДокумента.Организация, СтруктураШапкиДокумента.Дата);
			СтруктураШапкиДокумента.Вставить("ОрганизацияПрименяетУСН", СистемаНО);
	
			Движения	= ДокОперации.Движения.Хозрасчетный;
		
			ЧтениеДЖ  = Новый ЧтениеJSON;
    		ЧтениеДЖ.УстановитьСтроку(tchjs);
    		МассивДжи = ПрочитатьJSON(ЧтениеДЖ);
			ЧтениеДЖ.Закрыть();
			retval = retval+"Прочитали массив содержимого. ";
			Для каждого usl из МассивДжи Цикл
				Проводка = Движения.Добавить();
				Проводка.Организация = org.Ссылка;
				Проводка.Регистратор = ДокОперации.Ссылка;
				Проводка.Период = ДокОперации.Дата;
				Проводка.Содержание = usl.tn;
				Проводка.СчетДт = ПланыСчетов.Хозрасчетный.НайтиПоКоду(usl.dt);
				Проводка.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду(usl.kt);
				Проводка.ПодразделениеДт = Справочники.ПодразделенияОрганизаций.НайтиПоНаименованию(usl.dtu,Истина,,Проводка.Организация);
				Проводка.ПодразделениеКт = Справочники.ПодразделенияОрганизаций.НайтиПоНаименованию(usl.ktu,Истина,,Проводка.Организация);
				Если СистемаНо = Перечисления.СистемыНалогообложения.Упрощенная Тогда
					Если Число(usl.dsum)>0 Тогда
						Если стрДлина(usl.dahdtc)>8 Тогда
							//sdid1697
							//дв = selLastAccHistInDoc(Дата(СтрЗаменить(usl.dahdtc, "-","")),org.Ссылка);
							дв = selLastAccHistInDocFromCntr(Дата(СтрЗаменить(usl.dahdtc, "-","")),org.Ссылка,Справочники.Контрагенты.НайтиПоКоду(usl.ktc),Справочники.ДоговорыКонтрагентов.НайтиПоКоду(usl.ktdogkodc));
							//~sdid1697
						КонецЕсли;
					Иначе
						Если стрДлина(usl.kahdtc)>8 Тогда
							//sdid1697
							//дв = selLastAccHistInDoc(Дата(СтрЗаменить(usl.kahdtc, "-","")),org.Ссылка);
							дв = selLastAccHistInDocFromCntr(Дата(СтрЗаменить(usl.kahdtc, "-","")),org.Ссылка,Справочники.Контрагенты.НайтиПоКоду(usl.dtc),Справочники.ДоговорыКонтрагентов.НайтиПоКоду(usl.dtdogkodc));
							//~sdid1697
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				Если Число(usl.dsum)>0 Тогда
					Проводка.Сумма		= usl.dsum;
					Если НЕ usl.dval=0 Тогда
						Проводка.ВалютаДт	= Справочники.Валюты.НайтиПоКоду(usl.dval);
					КонецЕсли;
					Если стрДлина(usl.dahkodc)>0 Тогда
						БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, Справочники.БанковскиеСчета.НайтиПоКоду(usl.dahkodc));
					ИначеЕсли стрДлина(usl.dorgacc)>0 Тогда
						БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, Справочники.БанковскиеСчета.НайтиПоКоду(usl.dorgacc));
					КонецЕсли;
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Переоценка валют"));
					Если СистемаНо = Перечисления.СистемыНалогообложения.Упрощенная Тогда
						Если не дв=0 Тогда
