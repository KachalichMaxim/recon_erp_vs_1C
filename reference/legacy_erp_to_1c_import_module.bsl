Функция selAccHistInDoc(dt,num,org)
	Перем retval,sql;
	retval = 0;
	sql = "
		|ВЫБРАТЬ 
		|    Док.Ссылка
	    |ИЗ
    	|    Документ.ПоступлениеНаРасчетныйСчет КАК Док
    	|ГДЕ
		|    Док.Дата МЕЖДУ &НачДата И &КонДата
		|    И Док.Номер = &Номер
	    |    И Док.Организация = &Организация
