	Возврат(retval);
КонецФункции

//удалить ПоступлениеТоваровУслуг
Функция delAkt(dtc, numc, okod, ckod, c1guid, type)
	Перем retval,sql,Запрос,Результат,ТабЧасть,orgid,contrid,Объект,descr,isfind;
	retval="";
	Объект="";
	descr="";
	isfind=0;
	Если type=10 Тогда
		descr = descr+"10_";
		Если стрДлина(c1guid)>10 Тогда
			descr = descr+"c1guid_"+c1guid;
			Объект = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(c1guid)).ПолучитьОбъект();
			isfind=1;
		ИначеЕсли стрДлина(okod)>0 и стрДлина(ckod)>0 и стрДлина(numc)>0 Тогда
			orgid   = Справочники.Организации.НайтиПоКоду(okod);
			contrid = Справочники.Контрагенты.НайтиПоКоду(ckod);
			sql = "ВЫБРАТЬ
				| РеализацияТоваровУслуг.Ссылка
				|ИЗ
				| Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
				|ГДЕ
				| РеализацияТоваровУслуг.Номер = &Номер
				| И РеализацияТоваровУслуг.Дата МЕЖДУ &НачДата И &КонДата
				| И РеализацияТоваровУслуг.Организация = &Организация 
				| И РеализацияТоваровУслуг.Контрагент = &Контрагент
				|";
			Запрос = Новый Запрос(sql); 
			Запрос.УстановитьПараметр("Номер", numc);
			Запрос.УстановитьПараметр("НачДата",  dtc);
   			Запрос.УстановитьПараметр("КонДата",  КонецДня(dtc));
			Запрос.УстановитьПараметр("Организация", orgid.Ссылка);
			Запрос.УстановитьПараметр("Контрагент" , contrid.Ссылка);
			Результат = Запрос.Выполнить().Выбрать(); 
			Если Результат.Следующий() Тогда//нашли АКТ, удаляем
				Объект		= Результат.Ссылка.ПолучитьОбъект();
				isfind=1;
			КонецЕсли;
		Иначе
			retval="{""retval"":""false"",""msg"":""Не все обязательные парамтеры заданы (код организаци, код контрагента, код договора, номер документа)""}";
		КонецЕсли;
	ИначеЕсли type=7 Тогда
		descr = descr+"7_";
		Если стрДлина(c1guid)>10 Тогда
			descr = descr+"c1guid_"+c1guid;
			Объект = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(c1guid)).ПолучитьОбъект();
			isfind=1;
		ИначеЕсли стрДлина(okod)>0 и стрДлина(ckod)>0 и стрДлина(numc)>0 Тогда
			orgid   = Справочники.Организации.НайтиПоКоду(okod);
			contrid = Справочники.Контрагенты.НайтиПоКоду(ckod);
			sql = "ВЫБРАТЬ
				| ПоступлениеТоваровУслуг.Ссылка
				|ИЗ
				| Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
				|ГДЕ
				| ПоступлениеТоваровУслуг.Номер = &Номер
				| И ПоступлениеТоваровУслуг.Дата МЕЖДУ &НачДата И &КонДата
				| И Организация = &Организация И Контрагент = &Контрагент
				|";
			Запрос = Новый Запрос(sql); 
			Запрос.УстановитьПараметр("Номер", numc);
			Запрос.УстановитьПараметр("НачДата",  dtc);
   			Запрос.УстановитьПараметр("КонДата",  КонецДня(dtc));
			Запрос.УстановитьПараметр("Организация", orgid.Ссылка);
			Запрос.УстановитьПараметр("Контрагент" , contrid.Ссылка);
			Результат = Запрос.Выполнить().Выбрать(); 
			Если Результат.Следующий() Тогда//нашли АКТ, удаляем
				Объект		= Результат.Ссылка.ПолучитьОбъект();
				isfind=1;
			КонецЕсли;
		Иначе
			retval="{""retval"":""false"",""msg"":""Не все обязательные парамтеры заданы (код организаци, код контрагента, код договора, номер документа)""}";
		КонецЕсли;
	КонецЕсли;
	Если isfind=1 Тогда
		descr = descr+"obj_";
		Если type=7 Тогда
			ТабЧасть	= Объект.Услуги;
    		ТабЧасть.Очистить();
			ТабЧасть	= Объект.АгентскиеУслуги;
    		ТабЧасть.Очистить();
		КонецЕсли;
		Попытка
			Объект.Записать();
			descr = descr+"Записали_";
			Объект.УстановитьПометкуУдаления(Истина);
			descr = descr+"Удалили_";
			retval="{""retval"":""true"",""msg"":""описание: "+descr+"""}";
		Исключение
			retval="{""retval"":""false"",""msg"":""Ошибка обновления документа: "+ОписаниеОшибки()+"_"+descr+"""}";
		КонецПопытки;
	Иначе
		retval="{""retval"":""false"",""msg"":""Не найден документ для обновления ("+dtc+","+numc+","+orgid.Ссылка+","+contrid.Ссылка+"_"+descr+")""}";
	КонецЕсли;
	Возврат(retval);
КонецФункции

