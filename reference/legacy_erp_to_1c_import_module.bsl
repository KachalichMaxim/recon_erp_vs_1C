Функция getAcchist(dtb,dte,orgid)
	Перем retval,sql,org,Запрос,curret;
	retval="";
	Попытка
		Если orgid="0" Тогда
			sql = "
			| Выбрать Ссылка 
			| ИЗ Справочник.Организации";
			Запрос = Новый Запрос(sql); 
			Результат = Запрос.Выполнить().Выбрать(); 
			Пока Результат.Следующий() Цикл 
				Если Результат.Ссылка.ПометкаУдаления = Ложь Тогда
					//curret=Результат.Ссылка.Код+"-"+Результат.Ссылка.Наименование+";"+getAktsOneOrg(dtb,dte,Результат.Ссылка.Код);
					curret=getAcchistOneOrg(dtb,dte,Результат.Ссылка.Код);
					Если стрДлина(curret)>0 Тогда 
						Если стрДлина(retval)>0 Тогда 
							retval = retval+",";
						КонецЕсли;
						retval = retval+curret;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Иначе
			retval=getAcchistOneOrg(dtb,dte,orgid);
		КонецЕсли;
		retval="["+retval+"]";
		retval="[{""retval"":""true"",""msg"":"+retval+"}]";
	Исключение
		retval="[{""retval"":""false"",""msg"":""Ошибка получения выписки""}]";
	КонецПопытки;
	Возврат(retval);
КонецФункции

Функция createInvoice(orgid,obaccid,contrid,dogid,invsum,invval,invdt,invsrok,wnds,nomenk,grnd,invnum,kodc,dopstr,invst,dground,op)
	//clntkod, outSum,orgkod,wnds,nomenk,grnd,cval,dogkod,invdt
	Перем retval;
	msg="";
	retval="";
	wfind=0;
	sql = "";
	Если стрДлина(kodc)>1 И стрДлина(orgid)>1 И стрДлина(contrid)>1 Тогда
		sql = "
		|Выбрать 
		|	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
		|ГДЕ
		|	СчетНаОплатуПокупателю.ПометкаУдаления = ЛОЖЬ И
		|	СчетНаОплатуПокупателю.Дата МЕЖДУ &ДН И &ДК И
		|	СчетНаОплатуПокупателю.Организация.Ссылка.Код = &Организация И
		|	СчетНаОплатуПокупателю.Номер = &Номер
		|";
		Запрос = Новый Запрос(sql);
		Запрос.УстановитьПараметр("Номер", kodc);
		Запрос.УстановитьПараметр("Организация", orgid);
   		Запрос.УстановитьПараметр("ДН", invdt);//Дата всегда на 00:00:00
		Запрос.УстановитьПараметр("ДК", КонецДня(invdt));
		Результат = Запрос.Выполнить().Выбрать(); 
		Если Результат.Следующий() Тогда
			Объект = Результат.Ссылка.ПолучитьОбъект();
			wfind=1;
			msg=msg+"Нашли счет";
		КонецЕсли;
	КонецЕсли;
	Если стрДлина(orgid)>1 И invsum>0 И стрДлина(contrid)>1 Тогда
		Если wfind=0 Тогда
			Объект=Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
			msg=msg+"Создаем новый счет";
		КонецЕсли;
		Объект.Номер					= invnum;
		Объект.Дата						= invdt;
		Объект.Организация				= Справочники.Организации.НайтиПоКоду(orgid);
		Объект.Контрагент				= Справочники.Контрагенты.НайтиПоКоду(contrid);
		Объект.ДоговорКонтрагента		= Справочники.ДоговорыКонтрагентов.НайтиПоКоду(dogid);
		Объект.ОрганизацияПолучатель	= Объект.Организация;
		Если стрДлина(dopstr)>1 Тогда
			Объект.Комментарий	= dopstr;
		Иначе
			Объект.Комментарий	= "Счёт создан при импорте.";
		КонецЕсли;
		Объект.ВалютаДокумента			= Справочники.Валюты.НайтиПоКоду(invval);
		//Объект.СуммаВключаетНДС			= Ложь;
		Объект.СуммаВключаетНДС			= Истина;
		Объект.СуммаДокумента			= invsum;
		//Объект.ДокументБезНДС           = Истина;
		Объект.СтруктурнаяЕдиница		= Справочники.БанковскиеСчета.НайтиПоКоду(obaccid,,,Объект.Организация);
		msg=msg+" Подразделение: "+op+" ";
		Если стрДлина(op)>0 Тогда
			Объект.ПодразделениеОрганизации = Справочники.ПодразделенияОрганизаций.НайтиПоНаименованию(op,Истина,,Объект.Организация);
		Иначе
			Если orgid="БП-000001" Тогда
				Объект.ПодразделениеОрганизации	= Справочники.ПодразделенияОрганизаций.НайтиПоНаименованию("ОП ВК",Истина,,Объект.Организация);
			ИначеЕсли orgid="000000001" Тогда
				Объект.ПодразделениеОрганизации	= Справочники.ПодразделенияОрганизаций.НайтиПоНаименованию("ОП Нск",Истина,,Объект.Организация);
			Иначе
				Объект.ПодразделениеОрганизации	= Справочники.ПодразделенияОрганизаций.НайтиПоНаименованию("Основное",Истина,,Объект.Организация);
			КонецЕсли;
		КонецЕсли;
		ЧтениеДЖ = Новый ЧтениеJSON;
    	ЧтениеДЖ.УстановитьСтроку(nomenk);
    	МассивДжи = ПрочитатьJSON(ЧтениеДЖ);
		ЧтениеДЖ.Закрыть();
		ТабЧСч = Объект.Товары;
    	ТабЧСч.Очистить();
		сндс=0;
		Для каждого usl из МассивДжи Цикл
			ТабЧСч				= Объект.Товары.Добавить();
			ТабЧСч.Номенклатура	= Справочники.Номенклатура.НайтиПоКоду(usl.код);
			ТабЧСч.Цена			= usl.всум;
			ТабЧСч.Количество	= 1;
			ТабЧСч.Сумма		= usl.всум;
			Если usl.вндс="0" Тогда
				ТабЧСч.Сумма	= usl.всум;
				ТабЧСч.СтавкаНДС= Перечисления.СтавкиНДС.БезНДС;
				ТабЧСч.СуммаНДС	= 0;
			ИначеЕсли usl.вндс="1" Тогда
				ТабЧСч.Сумма	= usl.всум;
				ТабЧСч.СтавкаНДС= Перечисления.СтавкиНДС.НДС10;
				ТабЧСч.СуммаНДС	= usl.всум*10/110;
				сндс=1;
			ИначеЕсли usl.вндс="2" Тогда
				ТабЧСч.Сумма	= usl.всум;
				ТабЧСч.СтавкаНДС= Перечисления.СтавкиНДС.НДС20;
				ТабЧСч.СуммаНДС	= usl.всум*20/120;
				сндс=1;
			ИначеЕсли usl.вндс="3" Тогда
				ТабЧСч.Сумма	= usl.всум;
				ТабЧСч.СтавкаНДС= Перечисления.СтавкиНДС.НДС0;
				ТабЧСч.СуммаНДС	= 0;
			ИначеЕсли usl.вндс="4" Тогда
				ТабЧСч.Сумма	= usl.всум;
				ТабЧСч.СтавкаНДС= Перечисления.СтавкиНДС.НДС5;
				ТабЧСч.СуммаНДС	= usl.всум*5/105;
			ИначеЕсли usl.вндс="5" Тогда
				ТабЧСч.Сумма	= usl.всум;
				ТабЧСч.СтавкаНДС= Перечисления.СтавкиНДС.НДС7;
				ТабЧСч.СуммаНДС	= usl.всум*7/107;
			ИначеЕсли usl.вндс="6" Тогда
				ТабЧСч.Сумма	= usl.всум;
				ТабЧСч.СтавкаНДС= Перечисления.СтавкиНДС.НДС22;
				ТабЧСч.СуммаНДС	= usl.всум*22/122;
			Иначе
				ТабЧСч.Сумма	= usl.всум;
				ТабЧСч.СтавкаНДС= Перечисления.СтавкиНДС.БезНДС;
				ТабЧСч.СуммаНДС	= 0;				
			КонецЕсли;
			ТабЧСч.Содержание	= usl.восн;
		КонецЦикла;
		Если сндс=1 Тогда
			Объект.СуммаВключаетНДС			= Истина;
			//Объект.ДокументБезНДС           = Ложь;
		КонецЕсли;
		СтатусДокумента = РегистрыСведений.СтатусыДокументов.НовыеСтатусыДокумента();
		Если invst<2 ИЛИ (invst>3 И invst<7) Тогда
			СтатусДокумента.Статус = Перечисления.СтатусОплатыСчета.НеОплачен;
		ИначеЕсли invst=2 ИЛИ invst=7 Тогда
			СтатусДокумента.Статус = Перечисления.СтатусОплатыСчета.ОплаченЧастично;
		ИначеЕсли invst=3 ИЛИ invst=8 Тогда
			СтатусДокумента.Статус = Перечисления.СтатусОплатыСчета.Оплачен;
		ИначеЕсли invst=9 Тогда
			СтатусДокумента.Статус = Перечисления.СтатусОплатыСчета.Отменен;
		КонецЕсли;
